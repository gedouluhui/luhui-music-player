            <!-- 歌词行：整行可点跳转，hover 只给很淡的一层，不抢走文字注意力 -->
            <Style x:Key="LyricRowStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" Background="Transparent" CornerRadius="10">
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#07FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#0FFFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected" />
                                        <VisualState x:Name="PointerOverSelected" />
                                        <VisualState x:Name="PressedSelected" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slider 主题资源：只覆盖颜色，滑块/轨道的几何仍用系统模板（保留其手感） -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2A66F" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFB782" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFB782" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#2BFFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />

            <!-- 开关专用令牌：通用 ControlFill 在浅色下只有 5% 黑，Off 轨道几乎看不见。 -->
            <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ToggleTrackOffStrokeBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleKnobStrokeBrush" Color="#00FFFFFF" />

            <Style x:Key="SeekSliderStyle" TargetType="Slider">
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="StepFrequency" Value="1" />
                <Setter Property="Height" Value="22" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="GlassPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <!-- ============================ settings ============================ -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="18,16" />
            </Style>

            <!-- 分组标题比卡片内标题低一档，颜色退后，块与块之间才有层级而不是一堆同级大字。 -->
            <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="70" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>

            <!-- iOS 式拨杆开关：默认 ToggleSwitch 模板带 On/Off 文案和系统强调色，与本机玻璃语言不符。 -->
            <Style x:Key="SettingToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <Grid x:Name="Root" Background="Transparent" Width="46" Height="28">
                                <Border x:Name="Track" CornerRadius="14"
                                        Background="{StaticResource ToggleTrackOffBrush}"
                                        BorderBrush="{StaticResource ToggleTrackOffStrokeBrush}" BorderThickness="1" />
                                <Border x:Name="Knob" Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource ToggleKnobBrush}"
                                        BorderBrush="{StaticResource ToggleKnobStrokeBrush}" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Track.BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ToggleStates">
                                        <VisualState x:Name="Off" />
                                        <VisualState x:Name="On">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="Track.BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="Knob.Background" Value="#FFFFFF" />
                                                <Setter Target="Knob.BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="KnobShift.X" Value="18" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Dragging" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingSliderStyle" TargetType="Slider">
                <Setter Property="IsThumbToolTipEnabled" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="120" />
            </Style>

            <Style x:Key="ToolTipStyle" TargetType="ToolTip">
                <Setter Property="Background" Value="#EA12161E" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
