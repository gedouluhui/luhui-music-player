            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3AFFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="0.42" />
                <GradientStop Color="#0AFFFFFF" Offset="0.75" />
