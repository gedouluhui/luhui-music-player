            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7AEBC" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#717A8B" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#4E5665" />
