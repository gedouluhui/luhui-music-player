            <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#B3080A0E" />
            <SolidColorBrush x:Key="PanelFallbackBrush" Color="#0B0E14" />
            <SolidColorBrush x:Key="ArtFrameBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="ArtPlaceholderBrush" Color="#11161E" />
            <SolidColorBrush x:Key="SidebarPanelBrush" Color="#E00E121A" />
            <SolidColorBrush x:Key="BubbleBrush" Color="#E8151922" />
            <SolidColorBrush x:Key="LyricsSurfaceBrush" Color="#FF090B10" />
            <SolidColorBrush x:Key="BootOverlayBrush" Color="#F607090D" />
            <SolidColorBrush x:Key="ToastBrush" Color="#F012161E" />
