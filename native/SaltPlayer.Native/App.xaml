            <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFB782" />
            <SolidColorBrush x:Key="AccentOnBrush" Color="#1C1209" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EF2A66F" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF8080" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="NavFgBrush" Color="#A7AEBC" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="NavPressedBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#11FFFFFF" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="RowPressedBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="RowPlayingBrush" Color="#12F2A66F" />
